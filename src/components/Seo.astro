---
import { company } from "@/data/company";
import { analytics } from "@/data/analytics";
import { hrefLang, locales, switchPath, t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of an image under public/, used for OpenGraph and Twitter cards. */
  image?: string;
  type?: "website" | "article" | "product";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, image, type = "website", noindex = false, jsonLd = [] } = Astro.props;
const d = t(lang);
const fullTitle = title ? `${title} | ${d.meta.siteName}` : `${d.meta.siteName} | ${d.meta.tagline}`;
const desc = description ?? d.meta.defaultDescription;
const path = Astro.url.pathname;
const canonical = new URL(path, company.site).href;
const ogImage = new URL(image ?? `/og/og-default-${lang}.png`, company.site).href;
---
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
{locales.map((l) => (
  <link rel="alternate" hreflang={hrefLang(l)} href={new URL(switchPath(path, l), company.site).href} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(switchPath(path, "ar"), company.site).href} />

<meta property="og:type" content={type === "article" ? "article" : "website"} />
<meta property="og:site_name" content={d.meta.siteName} />
<meta property="og:title" content={title ?? d.meta.siteName} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
<meta property="og:locale" content={lang === "ar" ? "ar_EG" : "en_US"} />
<meta property="og:locale:alternate" content={lang === "ar" ? "en_US" : "ar_EG"} />
<meta name="twitter:card" content="summary_large_image" />

{analytics.googleSiteVerification && <meta name="google-site-verification" content={analytics.googleSiteVerification} />}

{jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
