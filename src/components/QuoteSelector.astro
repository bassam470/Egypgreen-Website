---
import Icon from "./Icon.astro";
import type { Product } from "@/data/products";
import { href, t, type Lang } from "@/i18n";

interface Props { product: Product; lang: Lang }
const { product: p, lang } = Astro.props;
const d = t(lang);
const s = p.selector;
const ui = lang === "ar"
  ? { choose: "اختر", added: "تمت الإضافة إلى السلة.", view: "عرض السلة وإرسال الطلب", heading: "أضف إلى طلب عرض السعر" }
  : { choose: "Choose", added: "Added to your cart.", view: "View cart and send request", heading: "Add to your quote request" };
const payload = { slug: p.slug, name: p.name, selector: s };
---
<form class="qs" data-quote-selector data-payload={JSON.stringify(payload)} data-lang={lang}>
  <h2 class="qs__title">{ui.heading}</h2>
  <div class="field">
    <label for={`qs-group-${p.slug}`}>{s.groupLabel[lang]}</label>
    <select id={`qs-group-${p.slug}`} class="select" data-group required>
      {s.groups.map((g, i) => <option value={String(i)}>{g.label[lang]}</option>)}
    </select>
  </div>
  <div class="field">
    <label for={`qs-option-${p.slug}`}>{s.optionLabel[lang]}</label>
    <select id={`qs-option-${p.slug}`} class="select" data-option required>
      {s.groups[0].options.map((o, i) => <option value={String(i)}>{o.label[lang]}</option>)}
    </select>
    <p class="qs__detail" data-detail aria-live="polite">{s.groups[0].options[0].detail?.[lang] ?? ""}</p>
  </div>
  <div class="field">
    <label for={`qs-qty-${p.slug}`}>{d.common.quantity}</label>
    <div class="qty">
      <button type="button" class="qty__btn" data-step="-1" aria-label="−"><Icon name="minus" size={18} /></button>
      <input id={`qs-qty-${p.slug}`} class="input qty__input" type="number" inputmode="numeric" min="1" max="9999" value="1" data-qty />
      <button type="button" class="qty__btn" data-step="1" aria-label="+"><Icon name="plus" size={18} /></button>
    </div>
  </div>
  <button type="submit" class="btn btn--primary btn--block"><Icon name="cart" size={20} />{d.common.addToQuote}</button>
  <div class="qs__done" data-done hidden>
    <Icon name="check" size={20} />
    <span>{ui.added} <a href={href(lang, "/quote")}>{ui.view}</a></span>
  </div>
  <p class="qs__note">{d.common.noPricesNote}</p>
</form>

<script>
  import { cart } from "@/scripts/cart";

  type L10n = { ar: string; en: string };
  interface Payload {
    slug: string;
    name: L10n;
    selector: {
      groupLabel: L10n;
      optionLabel: L10n;
      groups: { value: string; label: L10n; options: { value: string; label: L10n; detail?: L10n }[] }[];
    };
  }

  document.querySelectorAll<HTMLFormElement>("[data-quote-selector]").forEach((form) => {
    const data = JSON.parse(form.dataset.payload!) as Payload;
    const lang = form.dataset.lang as "ar" | "en";
    const groupSel = form.querySelector<HTMLSelectElement>("[data-group]")!;
    const optionSel = form.querySelector<HTMLSelectElement>("[data-option]")!;
    const detail = form.querySelector<HTMLElement>("[data-detail]")!;
    const qty = form.querySelector<HTMLInputElement>("[data-qty]")!;
    const done = form.querySelector<HTMLElement>("[data-done]")!;

    const group = () => data.selector.groups[Number(groupSel.value)];
    const option = () => group().options[Number(optionSel.value)];

    const fillOptions = () => {
      optionSel.replaceChildren(
        ...group().options.map((o, i) => new Option(o.label[lang], String(i))),
      );
      showDetail();
    };
    const showDetail = () => {
      detail.textContent = option()?.detail?.[lang] ?? "";
      done.hidden = true;
    };

    groupSel.addEventListener("change", fillOptions);
    optionSel.addEventListener("change", showDetail);
    form.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => {
        qty.value = String(Math.max(1, Math.min(9999, (Number(qty.value) || 1) + Number(b.dataset.step))));
      }),
    );

    // Allow deep links like ?group=6&option=3 from the spec tables.
    const params = new URLSearchParams(location.search);
    const gi = data.selector.groups.findIndex((g) => g.value === params.get("group"));
    if (gi >= 0) {
      groupSel.value = String(gi);
      fillOptions();
      const oi = group().options.findIndex((o) => o.value === params.get("option"));
      if (oi >= 0) { optionSel.value = String(oi); showDetail(); }
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const g = group(), o = option();
      cart.add({
        key: `${data.slug}|${g.value}|${o.value}`,
        product: data.slug,
        name: data.name,
        variant: {
          ar: `${data.selector.groupLabel.ar}: ${g.label.ar} · ${data.selector.optionLabel.ar}: ${o.label.ar}`,
          en: `${data.selector.groupLabel.en}: ${g.label.en} · ${data.selector.optionLabel.en}: ${o.label.en}`,
        },
        detail: o.detail,
        qty: Number(qty.value) || 1,
      });
      done.hidden = false;
      qty.value = "1";
    });
  });
</script>

<style>
  .qs { display: flex; flex-direction: column; gap: 16px; padding: 24px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); }
  .qs__title { font-size: 20px; line-height: 28px; }
  .qs__detail { font-size: 14px; line-height: 20px; color: var(--ink-muted); min-height: 20px; }
  .qty { display: flex; align-items: stretch; gap: 0; max-width: 180px; }
  .qty__btn { width: 44px; flex: none; border: 1px solid var(--line); background: var(--cloud); color: var(--ink); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .qty__btn:first-child { border-start-start-radius: var(--radius-md); border-end-start-radius: var(--radius-md); }
  .qty__btn:last-child { border-start-end-radius: var(--radius-md); border-end-end-radius: var(--radius-md); }
  .qty__btn:hover { background: var(--mist); }
  .qty__input { border-radius: 0; border-inline: 0; text-align: center; -moz-appearance: textfield; }
  .qty__input::-webkit-outer-spin-button, .qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .qs__done { display: flex; gap: 8px; align-items: flex-start; padding: 12px; border-radius: var(--radius-md); background: var(--leaf-tint); color: var(--pine); font-size: 15px; }
  .qs__done a { color: var(--pine); font-weight: 600; }
  .qs__note { font-size: 14px; line-height: 22px; color: var(--ink-muted); }
</style>
