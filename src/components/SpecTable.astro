---
import type { SpecTable } from "@/data/products";
import type { Lang } from "@/i18n";

interface Props { table: SpecTable; lang: Lang; headingLevel?: 2 | 3 }
const { table, lang, headingLevel = 3 } = Astro.props;
const cell = (c: string | { ar: string; en: string }) => (typeof c === "string" ? c : c[lang]);
const H: "h2" | "h3" = headingLevel === 2 ? "h2" : "h3";
---
{table.collapsible ? (
  <details class="spec spec--collapsible" id={table.id}>
    <summary>
      {table.image && <img src={table.image} alt="" width="64" height="64" loading="lazy" />}
      <span class="spec__title">{table.title[lang]}</span>
    </summary>
    <div class="spec__body">
      {table.note && <p class="spec__note">{table.note[lang]}</p>}
      <div class="table-wrap">
        <table class="table">
          <thead><tr>{table.columns.map((c) => <th scope="col">{c[lang]}</th>)}</tr></thead>
          <tbody>
            {table.rows.map((r) => (
              <tr>{r.map((c, i) => (i === 0 && table.rowHeads ? <th scope="row">{cell(c)}</th> : <td>{cell(c)}</td>))}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </details>
) : (
  <section class="spec" id={table.id}>
    <H class="spec__heading">{table.title[lang]}</H>
    {table.note && <p class="spec__note">{table.note[lang]}</p>}
    <div class="table-wrap">
      <table class="table">
        <thead><tr>{table.columns.map((c) => <th scope="col">{c[lang]}</th>)}</tr></thead>
        <tbody>
          {table.rows.map((r) => (
            <tr>{r.map((c, i) => (i === 0 && table.rowHeads ? <th scope="row">{cell(c)}</th> : <td>{cell(c)}</td>))}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
)}

<style>
  .spec { display: flex; flex-direction: column; gap: 12px; }
  .spec__heading { font-size: 20px; line-height: 28px; }
  .spec__note { font-size: 14px; line-height: 22px; color: var(--ink-muted); }
  .spec--collapsible { border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--white); gap: 0; }
  .spec--collapsible summary {
    display: flex; align-items: center; gap: 16px; padding: 12px 16px; cursor: pointer; list-style: none; font-weight: 600;
  }
  .spec--collapsible summary::-webkit-details-marker { display: none; }
  .spec--collapsible summary::after {
    content: "+"; margin-inline-start: auto; font-size: 22px; line-height: 1; color: var(--deep-green); font-weight: 400;
  }
  .spec--collapsible[open] summary::after { content: "−"; }
  .spec--collapsible[open] summary { border-block-end: 1px solid var(--line); }
  .spec--collapsible summary img { width: 56px; height: 56px; border-radius: var(--radius-sm); object-fit: cover; flex: none; }
  .spec__body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .spec__title { direction: inherit; }
</style>
