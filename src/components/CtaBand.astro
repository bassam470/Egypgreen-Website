---
import Icon from "./Icon.astro";
import { company, displayPhone, waLink } from "@/data/company";
import { href, t, type Lang } from "@/i18n";

interface Props { lang: Lang; title?: string; text?: string }
const { lang } = Astro.props;
const d = t(lang);
const title = Astro.props.title ?? (lang === "ar" ? "جاهز تطلب عرض سعر؟" : "Ready for a quote?");
const text = Astro.props.text ?? (lang === "ar"
  ? "أضف المنتجات إلى السلة وأرسلها على واتساب، أو كلمنا مباشرة. فريق المبيعات متاح 24 ساعة، والتوصيل لكل المحافظات."
  : "Add products to the cart and send it on WhatsApp, or call us directly. Sales is available 24 hours a day, with delivery to every governorate.");
---
<section class="cta-band">
  <div class="container cta-band__in">
    <div class="cta-band__text">
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="row">
      <a href={href(lang, "/quote")} class="btn btn--on-dark"><Icon name="cart" size={20} />{d.nav.quote}</a>
      <a href={waLink(d.common.waGreeting)} class="btn btn--outline-light" rel="noopener" target="_blank"><Icon name="whatsapp" size={20} />{d.common.whatsapp}</a>
      <a href={`tel:${company.phones[0]}`} class="btn btn--outline-light"><Icon name="phone" size={20} /><span class="ltr">{displayPhone(company.phones[0])}</span></a>
    </div>
  </div>
</section>

<style>
  .cta-band { background: var(--deep-green); color: var(--white); padding-block: 48px; position: relative; overflow: hidden; }
  .cta-band::before { content: ""; position: absolute; inset: 0; background: url("/patterns/egypgreen-pattern-deep.svg") repeat; background-size: 120px; opacity: 0.35; pointer-events: none; }
  .cta-band__in { position: relative; display: flex; flex-direction: column; gap: 24px; }
  @media (min-width: 960px) { .cta-band__in { flex-direction: row; align-items: center; justify-content: space-between; } }
  .cta-band h2 { color: var(--white); }
  .cta-band p { color: #DCEBE1; max-width: 620px; margin-top: 8px; }
</style>
