---
// One bilingual 404 page; .htaccess serves it for any missing path.
import "@/styles/tokens.css";
import "@/styles/global.css";
import { ar } from "@/i18n/ar";
import { en } from "@/i18n/en";
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>404 | ايجيب جرين · EgypGreen</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="nf">
      <img src="/logo/egypgreen-lockup-ar-en-color.svg" alt="ايجيب جرين" width="168" height="60" />
      <p class="nf__code">404</p>
      <div class="nf__cols">
        <section>
          <h1>{ar.notFound.title}</h1>
          <p>{ar.notFound.body}</p>
          <a href="/ar/" class="btn btn--primary">{ar.notFound.back}</a>
        </section>
        <section lang="en" dir="ltr">
          <h2>{en.notFound.title}</h2>
          <p>{en.notFound.body}</p>
          <a href="/en/" class="btn btn--secondary">{en.notFound.back}</a>
        </section>
      </div>
    </main>
  </body>
</html>

<style>
  .nf { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px; padding: 48px 16px; text-align: center; background: var(--mist); }
  .nf img { height: 56px; width: auto; }
  .nf__code { font-size: 72px; line-height: 1; font-weight: 600; color: var(--deep-green); font-family: var(--font-brand); }
  .nf__cols { display: grid; gap: 32px; max-width: 760px; width: 100%; }
  @media (min-width: 768px) { .nf__cols { grid-template-columns: 1fr 1fr; } }
  .nf section { display: flex; flex-direction: column; gap: 12px; align-items: center; padding: 24px; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-md); }
  .nf section[lang="en"] { font-family: var(--font-brand); }
  .nf h2 { font-size: clamp(30px, 4.2vw, 40px); line-height: 1.2; }
</style>
